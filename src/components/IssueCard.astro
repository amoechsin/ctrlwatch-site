---
interface Props {
  slug: string;
  number: string;
  date: string;
  title: string;
  subtitle: string;
  coverColor: string;
  tag: string;
  published: boolean;
  isLatest?: boolean;
  animationDelay?: number;
}

const {
  slug,
  number,
  date,
  title,
  subtitle,
  coverColor,
  tag,
  published,
  isLatest = false,
  animationDelay = 0,
} = Astro.props;

const issueUrl = `/issues/${slug}/`;
---

<article
  class="issue-card stagger-in"
  data-published={published ? 'true' : 'false'}
  data-latest={isLatest ? 'true' : 'false'}
  style={`animation-delay: ${animationDelay}ms; --cover-color: ${coverColor};`}
>
  <a href={issueUrl} class="issue-card-link" aria-label={`${number} — ${title}`}>
    <div class="issue-cover" style={`border-color: ${coverColor}; box-shadow: 0 0 8px ${coverColor}60, 0 0 20px ${coverColor}20;`}>
      {published ? (
        <img
          src={`/covers/${slug}-square.png`}
          alt={`Cover of CTRL+WATCH ${number} — ${title}`}
          class="issue-cover-img"
          loading="lazy"
          width="1080"
          height="1080"
        />
      ) : (
        <>
          <span class="issue-cover-number">{number}</span>
          <div class="issue-cover-overlay">
            <span class="coming-soon-text">COMING<br/>SOON</span>
          </div>
        </>
      )}
    </div>

    <div class="issue-meta">
      <div class="issue-meta-top">
        <span class="tag" style={`color: ${coverColor}; border-color: ${coverColor};`}>{tag}</span>
        {isLatest && <span class="tag tag-latest">[LATEST]</span>}
        <span class="issue-date">{date}</span>
      </div>

      <h2 class="issue-title">{title}</h2>
      <p class="issue-subtitle">{subtitle}</p>

      {published ? (
        <span class="btn issue-btn">READ NOW ▶</span>
      ) : (
        <span class="issue-btn-disabled">COMING SOON</span>
      )}
    </div>
  </a>
</article>

<style>
  .issue-card {
    display: block;
  }

  .issue-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, box-shadow 0.25s ease, transform 0.25s ease;
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .issue-card-link:hover,
  .issue-card-link:focus-visible {
    border-color: var(--cover-color, var(--green));
    box-shadow:
      0 0 12px color-mix(in srgb, var(--cover-color, var(--green)) 50%, transparent),
      0 0 32px color-mix(in srgb, var(--cover-color, var(--green)) 20%, transparent);
    transform: translateY(-2px);
    outline: none;
  }

  .tag-latest {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--yellow);
    border: 1px solid var(--yellow);
    padding: 4px 6px;
    letter-spacing: 0.1em;
    text-shadow: var(--glow-yellow);
  }

  .issue-cover {
    aspect-ratio: 1/1;
    border: 3px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: var(--bg);
    overflow: hidden;
  }

  .issue-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .issue-cover-number {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(24px, 5vw, 48px);
    color: var(--cover-color, var(--green));
    text-shadow: 0 0 20px currentColor;
    letter-spacing: 0.05em;
  }

  .issue-cover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 8, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed var(--text-muted);
  }

  .coming-soon-text {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(10px, 2vw, 14px);
    color: var(--text-secondary);
    text-align: center;
    letter-spacing: 0.1em;
    line-height: 1.8;
  }

  .issue-meta {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .issue-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .issue-date {
    font-family: 'Share Tech Mono', monospace;
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .issue-title {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(8px, 1.5vw, 11px);
    color: var(--text-primary);
    line-height: 1.8;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .issue-subtitle {
    font-family: 'Share Tech Mono', monospace;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .issue-btn {
    font-size: 8px;
    padding: 8px 16px;
    align-self: flex-start;
    margin-top: var(--space-xs);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .issue-btn-disabled {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    padding: 8px 16px;
    color: var(--text-muted);
    border: 1px dashed var(--text-muted);
    display: inline-block;
    letter-spacing: 0.1em;
    margin-top: var(--space-xs);
  }
</style>
