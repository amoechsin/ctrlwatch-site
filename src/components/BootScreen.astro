---

{/* Pre-paint check — set the seen class before the boot div paints to
    avoid a flash on returning sessions. is:inline keeps this out of
    Vite's processing pipeline. */}
<script is:inline>
  try {
    if (
      sessionStorage.getItem('ctrlwatch_boot_seen') === '1' ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      document.documentElement.classList.add('boot-seen');
    }
  } catch (e) {}
</script>

<div class="boot-screen" id="boot-screen" aria-live="polite" role="status">
  <div class="boot-content">
    <p class="boot-line boot-line-1">CTRL+WATCH MAGAZINE OS v1.0</p>
    <p class="boot-line boot-line-2">LOADING ISSUE DATABASE... &nbsp;&nbsp;&nbsp;[████████████] 100%</p>
    <p class="boot-line boot-line-3">CALIBRATING OPINION ENGINE... OK</p>
    <p class="boot-line boot-line-4">DISABLING ALGORITHM... &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;OK</p>
    <p class="boot-line boot-line-5 cursor">&gt; WELCOME TO CTRL+WATCH</p>
    <button class="boot-skip" type="button" id="boot-skip-btn" aria-label="Skip boot sequence">
      [ SKIP ▶ ]
    </button>
  </div>
</div>

<style>
  /* Pre-paint hide for returning sessions — set by inline script above. */
  :global(.boot-seen) .boot-screen {
    display: none;
  }

  .boot-screen {
    position: fixed;
    inset: 0;
    background: #000000;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.6s ease;
  }

  .boot-screen.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .boot-screen.hidden {
    display: none;
  }

  .boot-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    max-width: 600px;
    width: 100%;
  }

  .boot-line {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(8px, 1.5vw, 11px);
    color: var(--green);
    text-shadow: var(--glow-green);
    letter-spacing: 0.05em;
    line-height: 1.8;
    opacity: 0;
    animation: bootFadeIn 0.1s ease forwards;
    white-space: nowrap;
    overflow: hidden;
  }

  .boot-line-1 { animation-delay: 0.2s; }
  .boot-line-2 { animation-delay: 0.7s; }
  .boot-line-3 { animation-delay: 1.2s; }
  .boot-line-4 { animation-delay: 1.7s; }
  .boot-line-5 { animation-delay: 2.2s; }

  .boot-skip {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(8px, 1.5vw, 10px);
    color: var(--green);
    background: transparent;
    border: 1px solid var(--green);
    padding: 12px 20px;
    margin-top: var(--space-lg);
    letter-spacing: 0.1em;
    cursor: pointer;
    align-self: center;
    min-height: 44px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .boot-skip:hover,
  .boot-skip:focus-visible {
    background: var(--green);
    color: #000000;
    outline: none;
  }

  @keyframes bootFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Below 375px the boot animation overflows; skip it on tiny phones. */
  @media (max-width: 375px) {
    .boot-screen {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .boot-line {
      white-space: normal;
    }
  }
</style>

<script>
  const html = document.documentElement;
  const bootScreen = document.getElementById('boot-screen');
  const skipBtn = document.getElementById('boot-skip-btn');
  let dismissed = false;

  function markSeen() {
    try { sessionStorage.setItem('ctrlwatch_boot_seen', '1'); } catch {}
  }

  function dismissBoot() {
    if (dismissed) return;
    dismissed = true;
    markSeen();
    html.classList.add('boot-seen');
    bootScreen?.classList.add('fade-out');
    document.body.style.overflow = '';
    setTimeout(() => {
      bootScreen?.classList.add('hidden');
    }, 600);
  }

  // Returning visitor — boot already hidden via pre-paint class, skip wiring.
  if (!html.classList.contains('boot-seen')) {
    const autoTimer = setTimeout(dismissBoot, 3500);

    bootScreen?.addEventListener('click', () => {
      clearTimeout(autoTimer);
      dismissBoot();
    });

    skipBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      clearTimeout(autoTimer);
      dismissBoot();
    });

    if (bootScreen && !bootScreen.classList.contains('hidden')) {
      document.body.style.overflow = 'hidden';
    }
  }
</script>
