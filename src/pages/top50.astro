---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { issues } from '../data/issues.js';
import creatorsData from '../data/creators.json';

interface CreatorReview {
  issue: string;
  score: number | null;
  verdict: string | null;
  notes: string;
  approx: boolean;
}

interface CreatorReEval {
  issue: string;
  scoreChange: string;
  rankChange: string;
  notes: string;
}

interface Creator {
  name: string;
  slug: string;
  currentScore: number | null;
  verdict: string | null;
  genre: string | null;
  currentRank: number | null;
  status: 'in-top-50' | 'dropped' | 'never-entered';
  droppedAt: string | null;
  droppedReason: string | null;
  reEvaluated: boolean;
  reviews: CreatorReview[];
  reEvaluations: CreatorReEval[];
}

const SITE = 'https://ctrl-watch.xyz';

// The live Top 50, straight from the editorial source of truth (via
// creators.json, regenerated by `npm run build:creators`). No bespoke data
// layer — this page stays current whenever the tracker is rebuilt.
const top50 = (creatorsData.creators as Creator[])
  .filter((c) => c.status === 'in-top-50')
  .sort((a, b) => (a.currentRank ?? 999) - (b.currentRank ?? 999));

// Channels with a published canonical Player Profile — these get a /reviews/
// link and an ItemList item.url. Others stay name-only (never link to a 404).
const reviewSlugs = new Set(
  (await getCollection('reviews')).filter((e) => !e.data.draft).map((e) => e.id),
);
const reviewUrl = (slug: string) =>
  reviewSlugs.has(slug) ? `/reviews/${slug}/` : null;

// Issue-tag → URL map (mirrors creators.astro). Tracker uses #004S
// (Spectacle, published as canonical #004) and #004C (Craft, unpublished).
const publishedSlugs = new Set(issues.filter((i) => i.published).map((i) => i.slug));
const TRACKER_ALIASES: Record<string, string | null> = {
  '#004S': '004',
  '#004C': null,
};
function issueUrl(tag: string): string | null {
  if (tag in TRACKER_ALIASES) {
    const aliased = TRACKER_ALIASES[tag];
    return aliased && publishedSlugs.has(aliased) ? `/issues/${aliased}/` : null;
  }
  const stripped = tag.replace(/^#/, '').replace(/[A-Za-z]+$/, '');
  return publishedSlugs.has(stripped) ? `/issues/${stripped}/` : null;
}

// Most-recent issue a channel appeared in (review or re-eval) — links the
// channel to its freshest CTRL+WATCH coverage. Returns the linkable tag+href,
// or null when no issue ref exists (10 of the 50 carry no tag yet).
function latestIssueLink(c: Creator): { tag: string; href: string } | null {
  const tags = [...c.reviews.map((r) => r.issue), ...c.reEvaluations.map((r) => r.issue)];
  if (!tags.length) return null;
  const ranked = tags
    .map((t) => ({ tag: t, n: parseInt(t.replace(/[^0-9]/g, ''), 10) || 0 }))
    .sort((a, b) => b.n - a.n);
  for (const { tag } of ranked) {
    const href = issueUrl(tag);
    if (href) return { tag, href };
  }
  return null;
}

function verdictClass(v: string | null): string {
  if (!v) return 'verdict-unknown';
  return 'verdict-' + v.toLowerCase().replace(/\s+/g, '-');
}

const RANKING_DATE = 'May 2026';

const title = `Top 50 YouTube Channels — ${RANKING_DATE} | CTRL+WATCH`;
const description =
  'The 50 best YouTube channels right now, scored 0-100 across five axes and re-ranked every issue. The definitive list. Argue with it.';

// ItemList JSON-LD — mirrors the per-issue injector (position + name, no
// item.url until canonical /reviews/ pages exist). This is THE canonical
// ranking, so unlike the back-issue lists it points at /top50/ itself.
const itemListJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Top 50 YouTube Channels — CTRL+WATCH`,
  description:
    "CTRL+WATCH's master ranking of YouTube channels, updated every issue.",
  url: `${SITE}/top50/`,
  numberOfItems: top50.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: top50.map((c) => ({
    '@type': 'ListItem',
    position: c.currentRank,
    name: c.name,
    ...(reviewUrl(c.slug) ? { url: `${SITE}${reviewUrl(c.slug)}` } : {}),
  })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  </Fragment>

  <section class="top50-page">
    <div class="container">
      <header class="top50-header">
        <h1 class="top50-title">▶ THE TOP 50</h1>
        <p class="top50-tagline">
          THE 50 BEST CHANNELS ON YOUTUBE · RANKED · {RANKING_DATE.toUpperCase()}
        </p>
        <p class="top50-blurb">
          The master ranking. Every channel scored 0–100 across our five axes,
          re-ranked each issue. The number-one slot is earned, not rented.
          <a class="top50-creators-link" href="/creators/">See every channel we've reviewed →</a>
        </p>
      </header>

      <ol class="top50-list" aria-label="Top 50 YouTube channels ranked">
        {top50.map((c) => {
          const link = latestIssueLink(c);
          const rUrl = reviewUrl(c.slug);
          // Channel name links to its canonical Player Profile when one exists,
          // else to the most-recent issue it appeared in, else plain text.
          const nameHref = rUrl ?? link?.href ?? null;
          return (
            <li class="top50-row" id={`rank-${c.currentRank}`}>
              <span class="cell-rank" data-label="RANK">#{c.currentRank}</span>
              <span class="cell-name" data-label="CHANNEL">
                {nameHref ? (
                  <a class="channel-link" href={nameHref}>{c.name}</a>
                ) : (
                  <span class="channel-name">{c.name}</span>
                )}
                {rUrl && <span class="has-review" title="Full Player Profile">★</span>}
              </span>
              <span class={`cell-score score-${verdictClass(c.verdict).replace('verdict-', '')}`} data-label="SCORE">
                {c.currentScore != null ? c.currentScore : '—'}
              </span>
              <span class="cell-verdict" data-label="VERDICT">
                {c.verdict && <span class={`verdict ${verdictClass(c.verdict)}`}>{c.verdict}</span>}
              </span>
              <span class="cell-genre" data-label="GENRE">{c.genre || '—'}</span>
              <span class="cell-issue" data-label="REVIEWED IN">
                {link ? <a class="issue-link" href={link.href}>{link.tag}</a> : <span class="muted">—</span>}
              </span>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .top50-page {
    padding: var(--space-xl) 0;
    min-height: 60vh;
  }

  .top50-header {
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-md);
  }

  .top50-title {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .top50-tagline {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    color: var(--green);
    letter-spacing: 0.15em;
    text-shadow: var(--glow-green);
    margin-bottom: var(--space-md);
  }

  .top50-blurb {
    font-family: 'Share Tech Mono', monospace;
    font-size: var(--text-md);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 720px;
  }

  .top50-creators-link {
    color: var(--cyan);
    text-decoration: none;
    white-space: nowrap;
  }
  .top50-creators-link:hover { text-shadow: var(--glow-cyan); }

  /* ---- Ranked list ---- */
  .top50-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .top50-row {
    display: grid;
    grid-template-columns: 64px minmax(180px, 1.8fr) 70px 110px 1.4fr 90px;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-sm) var(--space-xs);
    border-bottom: 1px solid var(--border);
    font-family: 'Share Tech Mono', monospace;
    font-size: var(--text-sm);
    transition: background 0.12s ease;
  }
  .top50-row:hover { background: rgba(0, 255, 65, 0.03); }

  /* Spotlight the podium */
  .top50-row:nth-child(-n+3) .cell-rank { font-size: 14px; }

  .cell { min-width: 0; }
  .cell-rank {
    font-family: 'Press Start 2P', monospace;
    font-size: 11px;
    color: var(--green);
    letter-spacing: 0.05em;
  }

  .cell-name { font-size: var(--text-md); color: var(--text-primary); word-break: break-word; }
  .channel-link { color: var(--text-primary); text-decoration: none; }
  .channel-link:hover { color: var(--cyan); text-shadow: var(--glow-cyan); }
  .has-review { color: var(--yellow); font-size: 11px; margin-left: 6px; }

  .cell-score {
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
    letter-spacing: 0.05em;
  }
  .score-essential { color: var(--green); text-shadow: var(--glow-green); }
  .score-excellent { color: var(--cyan); }
  .score-good { color: var(--text-primary); }
  .score-average { color: var(--yellow); }
  .score-mediocre { color: var(--orange); }
  .score-game-over { color: var(--red); }
  .score-unknown { color: var(--text-muted); }

  .verdict {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    padding: 4px 6px;
    border: 1px solid currentColor;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .verdict-essential { color: var(--green); }
  .verdict-excellent { color: var(--cyan); }
  .verdict-good { color: var(--text-primary); }
  .verdict-average { color: var(--yellow); }
  .verdict-mediocre { color: var(--orange); }
  .verdict-game-over { color: var(--red); }

  .cell-genre { color: var(--text-secondary); font-size: var(--text-sm); }

  .issue-link {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    padding: 4px 6px;
    text-decoration: none;
    letter-spacing: 0.1em;
  }
  .issue-link:hover { background: var(--cyan); color: var(--bg); }
  .muted { color: var(--text-muted); }

  /* ---- Mobile: card stack ---- */
  @media (max-width: 768px) {
    .top50-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      padding: var(--space-md) var(--space-sm);
      border: 1px solid var(--border);
      margin-bottom: var(--space-sm);
    }

    .cell-score::before,
    .cell-verdict::before,
    .cell-genre::before,
    .cell-issue::before {
      content: attr(data-label) " ";
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      color: var(--text-muted);
      letter-spacing: 0.15em;
      margin-right: var(--space-sm);
    }

    .cell-rank {
      font-size: 13px;
    }
    .cell-name {
      font-size: var(--text-lg);
      border-bottom: 1px solid var(--border);
      padding-bottom: var(--space-xs);
      margin-bottom: var(--space-xs);
    }
    .cell-verdict:empty { display: none; }
  }
</style>
